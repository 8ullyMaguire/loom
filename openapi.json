{
  "openapi": "3.1.0",
  "info": {
    "title": "Loom API",
    "description": "",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/bundles": {
      "get": {
        "tags": [
          "crate::routes::bundles"
        ],
        "operationId": "list",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BundleDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "crate::routes::bundles"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBundleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBundleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bundles/{id}": {
      "get": {
        "tags": [
          "crate::routes::bundles"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleDto"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "crate::routes::bundles"
        ],
        "operationId": "edit",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditBundleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hidden-gems": {
      "get": {
        "tags": [
          "crate::routes::search"
        ],
        "operationId": "hidden_gems",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HiddenGemsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "get": {
        "tags": [
          "crate::routes::recommendations"
        ],
        "operationId": "recommendations",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationPageDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "crate::routes::search"
        ],
        "operationId": "search",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPageDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "tags": [
          "crate::routes::tags"
        ],
        "operationId": "aggregate",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagAggregateResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "crate::routes::tags"
        ],
        "operationId": "vote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TagVoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagAggregateResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BundleDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "feeds",
          "version"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "feeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateBundleRequest": {
        "type": "object",
        "required": [
          "name",
          "feeds"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "feeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateBundleResponse": {
        "type": "object",
        "required": [
          "id",
          "edit_token",
          "url"
        ],
        "properties": {
          "edit_token": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "EditBundleRequest": {
        "type": "object",
        "required": [
          "name",
          "feeds"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "feeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HiddenGemsDto": {
        "type": "object",
        "required": [
          "impression_share",
          "items"
        ],
        "properties": {
          "impression_share": {
            "type": "number",
            "format": "double"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHitDto"
            }
          }
        }
      },
      "RecommendationDto": {
        "type": "object",
        "required": [
          "uri",
          "name",
          "why"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      },
      "RecommendationPageDto": {
        "type": "object",
        "required": [
          "surface",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendationDto"
            }
          },
          "surface": {
            "type": "string"
          }
        }
      },
      "SearchHitDto": {
        "type": "object",
        "required": [
          "uri",
          "name",
          "description",
          "source",
          "ranking_mode",
          "score"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "ranking_mode": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "source": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          }
        }
      },
      "SearchPageDto": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHitDto"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TagAggregateResponse": {
        "type": "object",
        "required": [
          "status",
          "n"
        ],
        "properties": {
          "ci_high": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "ci_low": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "mean": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string"
          }
        }
      },
      "TagVoteRequest": {
        "type": "object",
        "required": [
          "feed",
          "tag",
          "confidence"
        ],
        "properties": {
          "confidence": {
            "type": "integer",
            "format": "int32"
          },
          "feed": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          }
        }
      }
    }
  }
}
